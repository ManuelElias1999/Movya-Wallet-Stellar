# Public configuration only. Never place a Stellar secret key in EXPO_PUBLIC_*.
EXPO_PUBLIC_STELLAR_NETWORK=testnet
EXPO_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
EXPO_PUBLIC_DEMO_ACCOUNT=

# Backend: Project URL and PUBLISHABLE key from Supabase's Connect dialog.
# Never use sb_secret_* or a service_role key in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Web hardening. The web build stores keys only in memory and sessions in
# localStorage; signing is disabled unless EXPO_PUBLIC_WEB_SIGNING=on is set explicitly.
# EXPO_PUBLIC_WEB_CSP=off disables the Content Security Policy (debug only).
EXPO_PUBLIC_WEB_SIGNING=off
EXPO_PUBLIC_WEB_CSP=on
