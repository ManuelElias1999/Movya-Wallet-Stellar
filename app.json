{
  "expo": {
    "name": "Movya Wallet",
    "slug": "movya-wallet-stellar",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/movya-logo.png",
    "userInterfaceStyle": "light",
    "scheme": "movya",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.movya.wallet.stellar"
    },
    "android": {
      "package": "com.movya.wallet.stellar",
      "adaptiveIcon": {
        "foregroundImage": "./assets/movya-logo.png",
        "backgroundColor": "#E8F1FF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Movya usa Face ID para confirmar que eres tú antes de firmar o mostrar tu respaldo."
        }
      ],
      "expo-font",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
